{
  "name": "ember-gravity-lab",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "NASA Physical Science Informatics (PSI) combustion research, spaceflight habitat fire safety audit engine, 2D hazard planner, and microgravity flame laboratory.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node --experimental-strip-types server/server.mjs --dev",
    "build": "tsc --noEmit && vite build && vite build --ssr server/server.mjs --outDir runtime",
    "build:client": "tsc --noEmit && vite build",
    "start": "node runtime/server.js",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "start:source": "node --experimental-strip-types server/server.mjs"
  },
  "dependencies": {
    "@types/three": "^0.187.0",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.187.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "^8.3.4"
  }
}
