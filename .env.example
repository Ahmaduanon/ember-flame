# Copy this file to .env next to package.json and restart Ember.
# Never share .env or put API keys into the browser, source code or a chat.
# Options: gemini | ollama | deepseek | openai | disabled
# (If GEMINI_API_KEY is provided, Ember automatically selects Gemini Flash)

# Google Gemini API (Recommended for fast cloud testing & vision)
# Get a free API key at: https://aistudio.google.com/
# EMBER_AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Ollama local offline alternative:
EMBER_AI_PROVIDER=ollama
EMBER_OLLAMA_URL=http://127.0.0.1:11434
# Recommended Ollama models: gemma3:4b (fast vision), llama3.2-vision, deepseek-r1:8b (reasoning)
EMBER_OLLAMA_MODEL=gemma3:4b

# DeepSeek Cloud alternative:
# EMBER_AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-chat

# OpenAI alternative:
# EMBER_AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Local port configuration:
EMBER_PORT=3001
