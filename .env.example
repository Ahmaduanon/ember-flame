# Copy this file to .env next to package.json and restart Ember.
# Never share .env or put API keys into the browser, source code or a chat.
EMBER_AI_PROVIDER=ollama
EMBER_OLLAMA_URL=http://127.0.0.1:11434
EMBER_OLLAMA_MODEL=gemma3:4b

# Optional paid cloud alternative. Switch EMBER_AI_PROVIDER to openai.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-luna

# Optional local port override:
# EMBER_PORT=3000
